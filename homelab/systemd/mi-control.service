[Unit]
Description=Market Intel phone control page (Tailscale-only)
After=network-online.target tailscaled.service
Wants=tailscaled.service
[Service]
User=ilias
ExecStart=/usr/bin/python3 /home/ilias/services/mi-control/app.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=false
[Install]
WantedBy=multi-user.target
