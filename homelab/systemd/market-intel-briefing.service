[Unit]
Description=Per-holding morning briefing to the phone
After=docker.service
OnFailure=notify-fail@market-intel-briefing.service

[Service]
Type=oneshot
User=ilias
WorkingDirectory=/home/ilias/market-intel/analysis
Environment=PATH=/home/ilias/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/ilias/market-intel/analysis/.venv/bin/python briefing.py --send
TimeoutStartSec=15min
CPUWeight=30
IOSchedulingClass=idle
MemoryHigh=1G
