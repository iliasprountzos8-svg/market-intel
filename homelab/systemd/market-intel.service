[Unit]
Description=Market Intel cycle (scrape, fulltext, classify, correlate, outcomes, notify)
After=network-online.target
Wants=network-online.target
OnFailure=notify-fail@market-intel.service
[Service]
Type=oneshot
User=ilias
WorkingDirectory=/home/ilias/market-intel
ExecStart=/home/ilias/market-intel/run_pull.sh
TimeoutStartSec=20min
Nice=10
