NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used by app/api/pipeline/* to dispatch/poll the cycle.yml GitHub Actions
# workflow (Mission Control's "Sync Now" + status). Server-side only -- no
# NEXT_PUBLIC_ prefix, never sent to the browser.
#   GITHUB_TOKEN: a token with `repo` scope (classic) or `actions:write` +
#     `contents:read` (fine-grained, scoped to this repo). Generate one at
#     https://github.com/settings/tokens, or reuse `gh auth token` for local
#     dev only.
#   GITHUB_OWNER / GITHUB_REPO: this repo's owner and name, e.g.
#     "yourname" / "market-intel".
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
